{
  "name": "@venkateshcv1809/prosetta-sdk",
  "version": "0.3.0",
  "description": "JavaScript SDK wrapper for the Polyglot Rosetta WebAssembly runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/venkateshcv1809/polyglot-rosetta-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/npm/index.cjs",
  "module": "./dist/npm/index.mjs",
  "types": "./dist/npm/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/npm/index.d.mts",
      "import": {
        "types": "./dist/npm/index.d.mts",
        "default": "./dist/npm/index.mjs"
      },
      "require": {
        "types": "./dist/npm/index.d.cts",
        "default": "./dist/npm/index.cjs"
      },
      "default": "./dist/npm/index.mjs"
    }
  },
  "files": [
    "dist/npm",
    "dist/prosetta-sdk.js",
    "dist/prosetta-sdk.js.map",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "yarn build:dev",
    "build:dev": "mise exec -- yarn clean && mise exec -- tsdown",
    "build:prod": "mise exec -- yarn clean && mise exec -- tsdown --config tsdown.prod.config.mts && npm pack --cache ./.cache/npm --pack-destination dist && node -e \"require('node:fs').rmSync('dist/npm', { recursive: true, force: true })\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3"
  }
}
